*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/
.claude/settings.local.json

# Build secrets. PostHog's symbol-upload key goes in the environment, or in a local .env that the
# Gradle plugin and the Xcode build phase read — never in the repo (docs/error-reporting.md).
.env
.env.*
!.env.example

# Private plans, kept outside the repository and linked in locally (AGENTS.md, "Plans"). No trailing
# slash, so the pattern also matches a symlink or junction, which git does not treat as a directory.
/plans

# Question-bank importer
tools/import/.venv/
tools/import/cache/
__pycache__/

# Store listing screenshots, pulled from the emulators by tools/screenshots/take-screenshots
/store-screenshots/

# SwiftPM's own state inside the generated linkage package; the package itself is committed
# (docs/dependencies.md, "SwiftPM linkage package").
app/iosApp/KotlinMultiplatformLinkedPackage/**/.build/
app/iosApp/KotlinMultiplatformLinkedPackage/**/.swiftpm/
app/iosApp/KotlinMultiplatformLinkedPackage/**/Package.resolved
